%YAML 1.2
---
name: Mise build system output
hidden: true
scope: text.build.mise
version: 2

variables:
  header: "--\\s+Available tasks:"
  prompt: "(--\\s+Task to run\\? >)(.*)"
contexts:
  main:
    - include: statements

  statements:
    - match: "{{header}}"
      scope: meta.header.mise constant.other.mise
      push: task-list
    - match: '^\[.+\]$'
      scope: comment.line.result.build-output.mise
    - match: "\\["
      scope: meta.brackets.mise punctuation.brackets.begin.mise
      push: task-output-prefix
    - match: ((?:[a-zA-Z]:[\/\\]|~\/|[.\/])?(?:[\w\-.]+[\/\\])+[\w\-.]+\.\w{1,5}):?(\d+)?:?(\d+)?
      captures:
        1: entity.name.filename.build-output.mise
        2: constant.numeric.line-number.build-output.mise
        3: constant.numeric.line-number.build-output.mise

  task-list:
    - match: "{{prompt}}"
      captures:
        1: meta.prompt.mise constant.other.mise
        2: meta.user-input.mise variable.other.constant.mise
      pop: 1
    - match: \w+
      scope: variable.other.constant.mise
      push: task-description

  task-description:
    - match: "[ \\t]+(.*)"
      captures:
        1: meta.description.mise
    - match: $\n?
      pop: true

  task-output-prefix:
    - meta_content_scope: variable.other.constant.mise
    - match: "]"
      scope: meta.brackets.mise punctuation.brackets.end.mise
      set: task-output-text

  task-output-text:
    - match: \s+(\$)\s+
      captures:
        1: meta.shell.prompt.mise constant.other.mise
      embed: scope:source.shell
      embed_scope: text.shell.embedded.mise
      escape: \n
    - match: $\n?
      pop: true

  user-input:
    - meta_content_scope: meta.user-input.mise variable.other.constant.mise
    - match: $\n?
      pop: true
